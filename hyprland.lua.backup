--
--
-- BRIGHTNESS
--
-- XF86MonBrightnessUp
--     Brightness +
--
-- XF86MonBrightnessDown
--     Brightness -
--
--
-- MEDIA
--
-- XF86AudioNext
--     Next track
--
-- XF86AudioPlay
--     Play / pause
--
-- XF86AudioPause
--     Play / pause
--
-- XF86AudioPrev
--     Previous track
--
--
-- SESSION
--
-- SUPER + SHIFT + Q
--     Exit Hyprland
--
------------------------------------------------------------


------------------------------------------------------------
-- DEBUG COMMANDS
------------------------------------------------------------
--
-- Reload:
--
--     hyprctl reload
--
--
-- Configuration errors:
--
--     hyprctl configerrors
--
--
-- Keybindings:
--
--     hyprctl binds
--
--
-- Windows:
--
--     hyprctl clients
--
--
-- Workspaces:
--
--     hyprctl workspaces
--
--
-- Monitors:
--
--     hyprctl monitors
--
--
-- Input devices:
--
--     hyprctl devices
--
--
-- Active window:
--
--     hyprctl activewindow
--
--
-- Active workspace:
--
--     hyprctl activeworkspace
--
------------------------------------------------------------


-- =========================================================
-- END OF CONFIGURATION
-- =========================================================
